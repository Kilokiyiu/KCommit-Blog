---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { listPosts } from '../../lib/api';
import { collectTags, tagPath } from '../../lib/posts';

const posts = await listPosts();
const tags = collectTags(posts);

function countFor(tag: string) {
  return posts.filter((p) => (p.tags ?? []).includes(tag)).length;
}
---

<BaseLayout title="标签" description="按标签浏览文章" noindex>
  <main class="shell">
    <PageHero title="标签" lead={tags.length === 0 ? undefined : '点一个标签，看相关文章。'} />

    {
      tags.length === 0 ? (
        <p class="empty-state">还没有标签。</p>
      ) : (
        <div class="tag-cloud">
          {tags.map((tag) => (
            <a class="tag tag-lg" href={tagPath(tag)}>
              {tag}
              <span class="tag-count">{countFor(tag)}</span>
            </a>
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
