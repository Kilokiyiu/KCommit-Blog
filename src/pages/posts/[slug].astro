---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import Giscus from '../../components/Giscus.astro';
import { getPost, listPosts, getSite } from '../../lib/api';
import { formatDate, readingMinutes } from '../../lib/format';
import { relatedPosts, tagPath } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await listPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const slug = Astro.params.slug!;
const post = await getPost(slug);
const site = await getSite();

if (!post) {
  return Astro.redirect('/posts/');
}

const all = await listPosts();
const index = all.findIndex((p) => p.id === slug);
const prev = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
const next = index > 0 ? all[index - 1] : null;
const minutes = readingMinutes(post.markdown);
const related = relatedPosts(post, all, 3);
const cover = post.cover ?? site.avatar;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  author: {
    '@type': 'Person',
    name: site.name,
    url: `https://github.com/${site.githubUser}`,
  },
  image: new URL(cover, Astro.site).href,
  mainEntityOfPage: new URL(`/posts/${post.id}/`, Astro.site).href,
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={cover}
  ogType="article"
  publishedTime={post.date}
  jsonLd={jsonLd}
>
  <div class="read-shell">
    <a class="back-link" href="/posts/">← 写过的</a>

    <article class="glass-panel read-panel">
      {
        post.cover && (
          <div class="read-cover" style={`--read-cover: url('${post.cover}')`} aria-hidden="true" />
        )
      }

      <header class="read-header">
        <p class="post-meta">
          <time datetime={post.date}>{formatDate(post.date, 'long')}</time>
          <span aria-hidden="true">·</span>
          <span>约 {minutes} 分钟</span>
        </p>
        <h1>{post.title}</h1>
        {post.description && <p class="read-desc">{post.description}</p>}
        {
          post.tags && post.tags.length > 0 && (
            <div class="tag-row read-tags">
              {post.tags.map((tag) => (
                <a class="tag" href={tagPath(tag)}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <MarkdownBody markdown={post.markdown} class="post-content prose" />

      <footer class="read-footer">
        <div class="read-nav">
          {
            prev ? (
              <a class="read-nav-link is-prev" href={`/posts/${prev.id}/`}>
                <span class="read-nav-label">更早</span>
                <span class="read-nav-title">{prev.title}</span>
              </a>
            ) : (
              <span class="read-nav-link is-empty" />
            )
          }
          {
            next ? (
              <a class="read-nav-link is-next" href={`/posts/${next.id}/`}>
                <span class="read-nav-label">更新</span>
                <span class="read-nav-title">{next.title}</span>
              </a>
            ) : (
              <span class="read-nav-link is-empty" />
            )
          }
        </div>

        {
          related.length > 0 && (
            <section class="related-posts" aria-labelledby="related-heading">
              <h2 id="related-heading">相关文章</h2>
              <ul>
                {related.map((item) => (
                  <li>
                    <a href={`/posts/${item.id}/`}>{item.title}</a>
                    <span>{item.description}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </footer>
    </article>

    <Giscus />
  </div>
</BaseLayout>
