---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="这儿没东西" description="我查过了，确实没有。">
  <main class="shell narrow">
    <section class="not-found">
      <h1>这儿没东西</h1>
      <p>
        我查过了，确实没有。
        <br />
        要不从首页重新找？
      </p>
      <a class="btn btn-primary" href="/">回首页</a>
      <p class="not-found-hint">也可能是我把它删了。</p>
    </section>
  </main>
</BaseLayout>
